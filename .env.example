# Supabase (https://supabase.com/dashboard)
# Use the project root URL — not /rest/v1/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only: Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/cron/* (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate-a-long-random-string

# Free key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Google Analytics 4 — Measurement ID (G-XXXXXXXX)
# https://analytics.google.com/ → Admin → Data streams → Web
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console — HTML tag verification content value only
# https://search.google.com/search-console → Add property → HTML tag
# Paste the content= value from: <meta name="google-site-verification" content="XXXX" />
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Public site URL (Stripe checkout redirects). Production: https://truckerslikeme.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Pro ($/mo Product + Price in Dashboard)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Price ID for monthly Pro (price_...)
STRIPE_PRICE_MONTHLY=
# Webhook secret for /api/billing/webhook (checkout.session.completed + subscription events)
STRIPE_WEBHOOK_SECRET=

# Optional — enables worldwide Find discovery (parking / diesel / repair)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Optional later
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_MAPBOX_TOKEN=
