# Supabase (https://supabase.com/dashboard)
# Use the project root URL — not /rest/v1/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only: Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/cron/* (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate-a-long-random-string

# Free key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Optional later
# OPENAI_API_KEY=
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_MAPBOX_TOKEN=
